# ─────────────────────────────────────────────────────────────────────
# Обязательное
# ─────────────────────────────────────────────────────────────────────

# Учётка MAX (DevTools → Application → Local Storage → web.max.ru)
MAX_TOKEN=your___oneme_auth_value
MAX_DEVICE_ID=your___oneme_device_id_value

# Токен Telegram-бота (@BotFather)
TG_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ID супергруппы с включёнными темами (форумом). Отрицательное число.
# Бот должен быть админом с правом «Управление темами».
# Каждый чат MAX получает свой топик внутри этой супергруппы.
TG_CHAT_ID=-1001234567890

# Кто имеет право писать от имени твоего аккаунта MAX — твой Telegram user ID
# (@userinfobot). Можно перечислить несколько через запятую.
# БЕЗ этой переменной мост не стартует: молча разрешать всей группе писать
# от твоего имени — не тот дефолт, который можно выбрать за тебя.
# Альтернатива — явно выбрать открытый режим: TG_ALLOW_ANY_MEMBER=true.
TG_ALLOWED_USER_ID=123456789

# ─────────────────────────────────────────────────────────────────────
# Доступ
# ─────────────────────────────────────────────────────────────────────

# Осознанный открытый режим: любой участник супергруппы может писать
# от твоего имени и управлять топиками.
# TG_ALLOW_ANY_MEMBER=false

# Кому можно /bind, /add, /del, /status, /retry — если нужно отделить
# управление от обычной отправки. По умолчанию = TG_ALLOWED_USER_ID.
# TG_ADMIN_USER_ID=123456789

# Фильтр ВХОДЯЩИХ чатов MAX (только приём; на отправку не влияет).
# Это маршрутизация, а не граница доступа.
# MAX_CHAT_IDS=-123,-456

# Разрешить отправку из Telegram в MAX (true/false).
REPLY_ENABLED=true

# ─────────────────────────────────────────────────────────────────────
# Уведомления и транспорт
# ─────────────────────────────────────────────────────────────────────

# Куда слать статусы моста (подключён / связь потеряна / восстановлена).
# Свой user ID — чтобы они не падали в общую супергруппу. Нужно предварительно
# нажать /start у бота. Без переменной статусы идут в General супергруппы.
# TG_STATUS_CHAT_ID=123456789

# SOCKS5/HTTP прокси для Telegram.
# TG_PROXY=socks5://127.0.0.1:1080

# Выбрасывать ли апдейты Telegram, накопившиеся за время простоя.
# По умолчанию false: включённый drop молча уничтожает всё, что ты написал,
# пока мост лежал.
# TG_DROP_PENDING_UPDATES=false

# ─────────────────────────────────────────────────────────────────────
# Хранилище и доставка
# ─────────────────────────────────────────────────────────────────────

# Каталоги. state/ содержит журнал доставки и карту топиков — терять нельзя.
# STATE_DIR=state
# LOG_DIR=logs
# SPOOL_DIR=state/spool

# Сколько дней держать записи о доставленных сообщениях. Окно должно с запасом
# перекрывать любой replay, который MAX может прислать после долгого простоя.
# JOURNAL_RETENTION_DAYS=14

# Durability SQLite: FULL | EXTRA | NORMAL | OFF.
# NORMAL/OFF быстрее, но при потере питания теряются последние записи журнала.
# SQLITE_SYNCHRONOUS=FULL

# Сколько раз пытаться доставить сообщение, прежде чем отложить его в DLQ
# (в топик уйдёт видимая отметка «не доставлено», чат не встаёт колом).
# DELIVERY_MAX_ATTEMPTS=5
# DELIVERY_RETRY_BASE_SEC=5

# ─────────────────────────────────────────────────────────────────────
# Медиа
# ─────────────────────────────────────────────────────────────────────

# Хосты, с которых мосту разрешено качать вложения (суффиксы, через запятую).
# Приватные, loopback и link-local адреса запрещены всегда, независимо от списка.
# MEDIA_ALLOWED_HOSTS=oneme.ru,max.ru,mycdn.me

# Снять ограничение по хостам (адресные проверки остаются).
# MEDIA_ALLOW_ANY_HOST=false
# MEDIA_ALLOW_PLAIN_HTTP=false

# Если роутер раздаёт fake-IP DNS (TUN-прокси: mihomo, sing-box и т.п.), все
# хосты резолвятся в 198.18.0.0/15, и без этой настройки ни одно вложение не
# скачается — в логе будет "resolves to non-public address". Allowlist хостов
# при этом продолжает действовать. Loopback и link-local сюда добавить нельзя.
# MEDIA_TRUSTED_NETS=198.18.0.0/15

# Потолок на один файл и общий бюджет спула на диске.
# MEDIA_MAX_BYTES=50331648
# SPOOL_BUDGET_BYTES=536870912
# DOWNLOAD_CONCURRENCY=4

# ─────────────────────────────────────────────────────────────────────
# Диагностика
# ─────────────────────────────────────────────────────────────────────

# DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=INFO

# Писать ли тексты сообщений и имена контактов в лог. По умолчанию нет:
# для разбора проблем доставки хватает ID, типа, размера и задержки.
# LOG_MESSAGE_TEXT=false

# Подробный режим + дамп сырых JSON протокола в debug/. Там персональные
# данные — удаляй после разбора. Токены редактируются всегда.
DEBUG=false

# Перебор экспериментальных URL для голосовых MAX. По умолчанию выключен:
# он тормозит чат и принимает за аудио что угодно, что не HTML.
# MAX_AUDIO_PROBING=false

# Переносить ли reply из Telegram в MAX. По умолчанию выключено, потому что
# формат поля link в SEND_MESSAGE не подтверждён захватом трафика web.max.ru.
# Если MAX его не примет, он ответит proto.payload и может закрыть WebSocket —
# то есть реконнект на каждое сообщение-ответ. Сопоставление «сообщение TG ↔
# сообщение MAX» работает и пишется в базу независимо от этого флага, так что
# включить его после проверки формата — правка одной строки в
# TelegramToMaxHandler._reply_link.
# MAX_REPLY_LINK=false

# Размер пула потоков для блокирующих вызовов (в первую очередь DNS).
# EXECUTOR_THREADS=4
# SHUTDOWN_TIMEOUT_SEC=25
